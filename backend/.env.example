# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elabs_registration_db

# Alternative individual connection params (if DATABASE_URL is not used)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elabs_registration_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
FRONTEND_URL=http://localhost:5173
